{
	"name": "freetv-tooling",
	"version": "1.0.0-beta",
	"description": "Tools to manage the build, testing, and deployment process of freetv-viewer, freetv-server, and freetv-data.",
	"author": "Ken Dawson",
	"license": "GPL-3.0-only",
	"homepage": "https://freetv.today",
	"reponsitory": "https://github.com/freetv-today/freetv-tooling",
	"bugs": "https://github.com/freetv-today/freetv-tooling/issues",
	"private": false,
  "private": true,
  "type": "module",
  "scripts": {
    "dev:php-server": "node scripts/dev-php-server.js",
    "dev:view": "node scripts/dev-view.js",
    "dev:server": "node scripts/dev-server.js",
    "dev:all": "node scripts/dev-all.js",
    "build:view": "node scripts/build-view.js",
    "build:server": "node scripts/build-server.js",
    "build:data": "node scripts/build-data.js",
    "build:all": "npm run build:view && npm run build:server && npm run build:data && npm run assemble && npm run verify",
    "assemble": "node scripts/assemble.js",
    "verify": "node scripts/verify.js",
    "status": "node scripts/status.js"
  },
  "dependencies": {
    "fs-extra": "^11.0.1"
  }
}
